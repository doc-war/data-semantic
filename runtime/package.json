{
  "name": "data-semantic",
  "version": "1.2.0",
  "description": "AI-native semantic render runtime for modern web.",
  "keywords": [
    "data-*",
    "data-semantic",
    "semantic protocol",
    "ai-native",
    "data semantic protocol"
  ],
  "type": "module",
  "main": "./dist/runtime.umd.js",
  "module": "./dist/runtime.es.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/runtime.es.js",
      "default": "./dist/runtime.umd.js"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.umd.config.js",
    "dev": "vite",
    "test": "node test/runtime.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doc-war/data-semantic"
  },
  "homepage": "https://doc-war.com/data-semantic",
  "license": "MIT"
}
